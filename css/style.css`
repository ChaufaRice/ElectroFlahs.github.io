/* Variables de Marca */
:root {
    --primary: #006e19;
    --primary-light: #2fa83a;
    --primary-dark: #004d12;
    --surface: #fbf8ff;
    --surface-dim: #dad9e3;
    --on-surface: #1a1b22;
    --on-surface-variant: #3e4a3b;
    --inverse-surface: #2f3038;
    --outline-variant: #bdcab7;
}

body {
    font-family: 'Inter', sans-serif;
    scroll-behavior: smooth;
}

h1, h2, h3, .font-display {
    font-family: 'Montserrat', sans-serif;
}

/* Fondo de Cuadrícula Técnica */
.grid-bg {
    background-image:
        linear-gradient(to right, #E7E7E4 1px, transparent 1px),
        linear-gradient(to bottom, #E7E7E4 1px, transparent 1px);
    background-size: 24px 24px;
}

/* Efectos de Cristal y Glow */
.backdrop-blur-md {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.btn-glow {
    transition: all 0.3s ease;
    box-shadow: 0 0 0 rgba(0, 110, 25, 0);
}

.btn-glow:hover {
    box-shadow: 0 0 20px rgba(0, 110, 25, 0.4);
    transform: translateY(-2px);
}

/* Animaciones */
@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
}

.scroll-indicator {
    animation: bounce 2s infinite;
}

/* Estilos de Formulario Técnico */
.form-input-bottom-border {
    border: none;
    border-bottom: 1px solid var(--surface-dim);
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    background-color: transparent;
    transition: border-color 0.3s ease;
}

.form-input-bottom-border:focus {
    border-bottom-color: var(--primary);
    box-shadow: none;
    outline: none;
}

/* Utilidades de Acento */
.tech-corner {
    position: relative;
}

.tech-corner::before, .tech-corner::after {
    content: '';
    position: absolute;
    width: 4px;
    height: 4px;
    border: 1px solid var(--outline-variant);
}
